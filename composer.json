{
    "name": "monkward/monkward",
    "description": "An on-the-fly Markdown viewer served over localhost, installable as a PHAR.",
    "type": "project",
    "license": "MIT",
    "keywords": ["markdown", "viewer", "cli", "phar", "server"],
    "require": {
        "php": ">=8.5",
        "league/commonmark": "^2.6",
        "substancephp/container": "^0.6.2",
        "substancephp/http": "^0.7.1"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "humbug/box": "^4.7",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.1",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Monkward\\": "src/"
        }
    },
    "bin": [
        "bin/monkward"
    ],
    "scripts": {
        "test": "phpunit",
        "lint:check": [
            "php-cs-fixer fix --dry-run --diff",
            "phpcs"
        ],
        "lint:fix": "php-cs-fixer fix",
        "stan": "phpstan analyse --no-progress",
        "build:phar": "bin/build-phar",
        "box": "@build:phar"
    },
    "config": {
        "sort-packages": true
    }
}
